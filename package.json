{
  "name": "pi-monitor",
  "version": "0.1.0",
  "description": "Pi package that steers an agent when a local Linux/WSL process tree terminates",
  "type": "module",
  "keywords": [
    "pi-package",
    "process-monitoring",
    "background-tasks",
    "local-tasks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jollyxenon/pi-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/jollyxenon/pi-monitor/issues"
  },
  "homepage": "https://github.com/jollyxenon/pi-monitor#readme",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@types/node": "^24.12.0",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
